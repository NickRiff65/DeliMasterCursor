# Copiar este archivo como .env y completar los valores. Nunca subir .env al repositorio.
PORT=3000
NODE_ENV=development

# PostgreSQL local (en producción basta con definir DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ESCRIBE_AQUI_TU_CONTRASENA_DE_POSTGRES
DB_NAME=delimaster
DB_NAME_TEST=delimaster_test

# Secreto para firmar los JWT (cadena larga y aleatoria) y duración de la sesión
# Mínimo 32 caracteres aleatorios. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO
JWT_EXPIRA=7d

# Comisión de la plataforma en puntos porcentuales (10 a 15 según el modelo de negocio)
COMISION_PORCENTAJE=12

# ---------------------------------------------------------------- seguridad (producción)
# Sesiones de administración (por defecto 8 horas)
# JWT_EXPIRA_ADMIN=8h
# Dominios web autorizados a llamar a la API, separados por coma (obligatorio en producción)
# CORS_ORIGENES=https://admin.delimaster.cl
# Detrás del proxy del proveedor (Render, Railway…): número de proxies de confianza.
# Con Tailscale Funnel en este mismo equipo: TRUST_PROXY=loopback (sin esto, todos los usuarios
# compartirían los límites de intentos, porque llegarían con la IP 127.0.0.1)
# TRUST_PROXY=1
# URL pública de la API, para los enlaces de retorno de Webpay y de las boletas
# URL_PUBLICA_API=https://api.delimaster.cl/api

# ---------------------------------------------------------------- correo (recuperar contraseña)
# Correos (código de recuperación y avisos de cada etapa de las solicitudes). Con Gmail: activar la
# verificación en dos pasos y crear una "contraseña de aplicación". Probar con: npm run probar-correo -- --para persona@ejemplo.cl
# Sin SMTP, los correos se muestran en la consola del backend (útil en desarrollo).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USUARIO=cuenta@gmail.com
# SMTP_CLAVE=contraseña-de-aplicación
# CORREO_REMITENTE=DeliMaster <no-responder@ejemplo.cl>

# Avisos con la app cerrada: el celular registra su token de Expo y la API lo envía a
# https://exp.host/--/api/v2/push/send. No hay clave que configurar aquí. Hace falta una APK
# compilada después de agregar expo-notifications (la versión web no recibe estos avisos).

# Cada cuántos milisegundos se revisan los plazos (respuesta, cierre a las 72 h y visita sin llegada).
# PLAZOS_INTERVALO_MS=60000
